[user]
	email = {{email}}
	name = {{username}}

[include]
	path = /etc/gitconfig.delta

[core]
	pager = delta
	autocrlf = input

[diff]
	colorMoved = dimmed-zebra

[delta]
	syntax-theme = gruvbox-dark
	features = woolly-mammoth
	map-styles = bold purple => syntax magenta, bold cyan => syntax blue
	plus-style = syntax "#243d32"
	plus-non-emph-style = syntax "#243d32"
	plus-emph-style = syntax "#356b4a"
	plus-empty-line-marker-style = normal "#243d32"


[alias]
	s = status
	c = commit --message
	diffc = diff --cached
	amend = commit --amend --no-edit
	unadd = restore --staged
	lg = log --date-order --graph --all --date=short --pretty=format:'%x09%C(auto)%h  %C(cyan)%ad  %C(green)%<(12,trunc)%aN    %C(reset)%<(80,trunc)%s    %C(auto)%d'
	cleanup = "!f() { trunk=${1:-$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)}; trunk=${trunk#origin/}; trunk=${trunk:-main}; git checkout -q \"$trunk\" && git for-each-ref refs/heads/ \"--format=%(refname:short)\" | while read branch; do mergeBase=$(git merge-base \"$trunk\" $branch) && [[ $(git cherry \"$trunk\" $(git commit-tree $(git rev-parse \"$branch^{tree}\") -p $mergeBase -m _)) == \"-\"* ]]  && git branch -D $branch; done; }; f"

[merge]
	tool = "nvim"

[mergetool "nvim"]
	cmd = nvim -d $BASE $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[push]
	autoSetupRemote = true

{{#if git_credential_helper}}
[credential]
	helper = {{git_credential_helper}}
{{/if}}
