#!/usr/bin/env bash
set -euo pipefail

fzf_binds="alt-j:preview-down,alt-k:preview-up,\
ctrl-alt-d:preview-half-page-down,ctrl-alt-u:preview-half-page-up,\
alt-p:toggle-preview,alt-w:toggle-preview-wrap-word"

if [[ "${1-}" == "--fzf-jump" ]]; then
    fd_args=(--follow --type f --exclude .git)
    [[ "${NNN_INCLUDE_HIDDEN:-0}" == "1" ]] && fd_args+=(--hidden)

    if command -v bat >/dev/null 2>&1; then
        preview="bat --style=numbers --color=always -- {}"
    else
        preview="cat -- {}"
    fi

    set +e
    selection=$(fd "${fd_args[@]}" | fzf --reverse --bind="$fzf_binds" \
        --preview="$preview" --preview-window=down \
        --header="↵ locate in nnn │ $PWD")
    status=$?
    set -e

    [[ $status -eq 1 || $status -eq 130 ]] && exit 0
    [[ $status -ne 0 ]] && exit "$status"
    [[ -z "$selection" ]] && exit 0

    selection="${selection#./}"
    if [[ "$PWD" == "/" ]]; then
        selection="/$selection"
    else
        selection="$PWD/$selection"
    fi

    printf '0c%s' "$selection" > "$NNN_PIPE"
    exit 0
fi

if [[ "${1-}" == "--pick-dir" ]]; then
    printf '%s\0' "$PWD" > "$2"
    printf '0p' > "$NNN_PIPE"
    exit 0
fi

[[ -z "${TMUX-}" ]] && { echo "Must run inside tmux." >&2; exit 1; }

pane_id=$(tmux display-message -p '#{pane_id}')
pane_dir=$(tmux display-message -p '#{pane_current_path}')
pane_pid=$(tmux display-message -p '#{pane_pid}')

at_prefix=false
if pgrep -P "$pane_pid" -f '.*claude.*|node.*gemini|codex' >/dev/null 2>&1; then
    at_prefix=true
fi

picker_output=$(mktemp "${TMPDIR:-/tmp}/tmux-nnn-path.XXXXXX")
trap 'rm -f "$picker_output"' EXIT

printf -v picker_output_arg '%q' "$picker_output"
plugins="f:!tmux-fzf-path --fzf-jump*;d:!tmux-fzf-path --pick-dir $picker_output_arg*"
NNN_PLUG="$plugins" nnn -0 -p "$picker_output" "$pane_dir"

selections=()
while IFS= read -r -d '' selection; do
    selections+=("$selection")
done < "$picker_output"

[[ ${#selections[@]} -eq 0 ]] && exit 0

pane_prefix="${pane_dir%/}/"
output=""
for selection in "${selections[@]}"; do
    if [[ "$selection" == "$pane_dir" ]]; then
        selection="./"
    elif [[ "$selection" == "$pane_prefix"* ]]; then
        selection="${selection#"$pane_prefix"}"
    fi

    if $at_prefix; then
        output+="@$selection "
    else
        printf -v escaped '%q' "$selection"
        output+="$escaped "
    fi
done

tmux send-keys -t "$pane_id" -l -- "$output"
