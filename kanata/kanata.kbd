;; Version 1.11.0 does not have tap-hold-require-prior-idle yet. Requires building from main branch.
;; Just symbols
(defalias
    ~ S-`
    ! S-1
    @ S-2
    # S-3
    $ S-4
    % S-5
    ^ S-6
    & S-7
    * S-8
    lpr S-9
    rpr S-0
    _ S--
    + S-=
    { S-[
    } S-]
    | S-\
    : S-;
    dbq S-'
    < S-,
    > S-.
    ? S-/
)

(defcfg
    process-unmapped-keys yes
)

(deflocalkeys-macos
    lalt 125
    lmet 56
    rmet 100
)

(defvar
    tap-hold 100
    hold-timeout 300
)

(deftemplate
    hrmod (key hold-action prior-idle) (
        tap-hold-release $tap-hold $hold-timeout $key $hold-action (
            require-prior-idle $prior-idle
        )
    )
)
(deftemplate
    hrmod-repeat (key hold-action prior-idle) (
        tap-dance 100 ((t! hrmod $key $hold-action $prior-idle) (multi $key))
    )
)

(platform (macos)
    (defalias
      wmod lmet
    )
)

(platform (linux)
    (defalias
        wmod lctl
    )
)

(defalias
    bw (multi @wmod bspc)

    caps  (tap-hold-release 100 150
              (tap-dance 150 (esc (layer-switch mov)))
              (layer-while-held mov)
          )
    ' (t! hrmod ' (layer-toggle mov) 50)
    spc   (t! hrmod spc (layer-toggle sym) 50)

    a (t! hrmod a lmet 150)
    s (t! hrmod s lalt 150)
    d (t! hrmod d lsft 50)
    f (t! hrmod f lctl 150)

    j (t! hrmod j rctl 150)
    k (t! hrmod k rsft 50)
    l (t! hrmod l lalt 150)
    ; (t! hrmod ; rmet 150)
)

;; Layers
(defsrc
         q    w    e    r    t    y    u    i    o    p    [    ]
    caps a    s    d    f    g    h    j    k    l    ;    '
         z    x    c    v    b    n    m    ,    .    /
                             spc
)

(deflayer default
          q    w    e    r    t    y    u    i    o    p    [    ]
    @caps @a   @s   @d   @f   g    h    @j   @k   @l   @;   @'
          z    x    c    v    b    n    m    ,    .    /
                              @spc
)

(deflayermap mov
    esc  (layer-switch default)
    caps (layer-switch default)

    h left
    j (t! hrmod down rctl 150)
    k (t! hrmod up rsft 50)
    l (t! hrmod right lalt 150)

    w (multi @wmod right)
    e (multi @wmod right)
    b (multi @wmod left)

    a (t! hrmod Home lmet 150)
    f (t! hrmod End lctl 150)
    u PageUp
    d (t! hrmod PageDown lsft 50)

    rsft (caps-word-toggle 5000)

    p bspc
    [ @bw
    x del
)

(deflayer sym
         @!   @+   -    @*   @|   @&   [    @{   @}   ]    [    ]
    _    @^   eql  @_   @$   \    /    @dbq @lpr @rpr ;    '
         @~   _    @%   `    @@   @#   @:   @<   @>  @?
                             spc
)
