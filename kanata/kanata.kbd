;; Version 1.11.0 does not have tap-hold-require-prior-idle yet. Requires building from main branch.
(defcfg
    process-unmapped-keys yes
)

(defsrc
    caps a s d f g h j k l ;
)

(defvar
    tap-hold 100
    hold-timeout 150
)

(deftemplate
    hrmod (key hold-action prior-idle) (
        tap-hold-release $tap-hold $hold-timeout $key $hold-action (
            require-prior-idle $prior-idle
        )
    )
)
(deftemplate
    hrmod-repeat (key hold-action prior-idle) (
        tap-dance 100 ((t! hrmod $key $hold-action $prior-idle) (multi $key))
    )
)

(defalias
    caps (t! hrmod esc (layer-toggle movement) 150)
    a (t! hrmod a lmet 150)
    s (t! hrmod s lalt 150)
    d (t! hrmod d lsft 50)
    f (t! hrmod f lctl 150)

    j (t! hrmod j rctl 150)
    k (t! hrmod k rsft 50)
    l (t! hrmod l lalt 150)
    ; (t! hrmod ; rmet 150)
)

(deflayer default
    @caps @a @s @d @f _ _ @j @k @l @;
)

(deflayermap movement
    u PageUp
    d PageDown
    h left
    j down
    k up
    l right
    rsft (caps-word-toggle 5000)
)
